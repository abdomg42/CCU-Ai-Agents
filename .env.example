# Copier ce fichier en .env et ajuster les variables si nécessaire.
MOCK_LLM=false

# Ollama LLM
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:latest

# Neo4j GraphRAG
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password
NEO4J_DATABASE=neo4j

# Embeddings
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=mxbai-embed-large:latest
VECTOR_INDEX_DIM=1024
VECTOR_SIMILARITY_THRESHOLD=0.75

# Anthropic (génération de tickets CCU synthétiques)
# ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-3-5-sonnet-20240620

# Zammad
ZAMMAD_URL=http://localhost:3000
ZAMMAD_TOKEN=your_zammad_api_token_here
ZAMMAD_DEFAULT_GROUP=Users

# Mailhog (SMTP local)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=diagnostic-agent@ccu.local
REPORT_RECIPIENTS=noc@ccu.local,support@ccu.local

# Streamlit UI backend URL (port 8000 en local)
BACKEND_URL=http://localhost:8000

# Ticket mapping
TICKET_MAPPING_SIMILARITY_THRESHOLD=0.85
